# Zorg dat mod_headers is ingeschakeld op je Apache server
<IfModule mod_headers.c>

  # Content Security Policy – sta Google toe voor Google Sign-In
  Header set Content-Security-Policy "default-src 'self'; 
    script-src 'self' https://apis.google.com https://accounts.google.com https://www.gstatic.com; 
    connect-src 'self' https://accounts.google.com https://www.googleapis.com; 
    img-src 'self' data: https://lh3.googleusercontent.com https://ssl.gstatic.com; 
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; 
    font-src 'self' https://fonts.gstatic.com;
    frame-src https://accounts.google.com; 
    frame-ancestors 'self';
    object-src 'none'; 
    base-uri 'self';"
  
  # Zorg dat de browser geen MIME-type sniffing doet
  Header set X-Content-Type-Options "nosniff"

  # Clickjacking bescherming
  Header always set X-Frame-Options "SAMEORIGIN"

  # XSS-bescherming (wordt niet meer breed ondersteund maar kan geen kwaad)
  Header set X-XSS-Protection "1; mode=block"

</IfModule>